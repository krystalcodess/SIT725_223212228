# Server
PORT=3000
NODE_ENV=production

# Database (Docker Compose overrides these hostnames at runtime)
MONGODB_URI=mongodb://mongo:27017/kfz-legal
RAG_MONGODB_URI=mongodb://mongo:27017/kfz-legal-rag

# JWT (must be at least 32 characters)
JWT_SECRET=replace_with_a_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# RAG / AI (required for document upload ingestion and chat)
# Do not commit real keys. Provide working keys via your OnTrack submission.
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# RAG - optional model overrides
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=claude-sonnet-4-6
